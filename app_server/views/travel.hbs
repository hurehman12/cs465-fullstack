<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <title>Travlr Getaways - Travel</title>
    <link rel="stylesheet" href="/css/style.css" type="text/css">
</head>

<body>
    <div id="background">
        <div id="page">

            {{> header }}

            <div id="contents">
                <div class="box">
                    <div>
                        <div class="body">

                            <h1>Travel</h1>

                            <!-- Customer trip preferences -->
                            <h2>Find Your Perfect Trip</h2>

                            <form method="GET" action="/travel">

                                <p>
                                    <label for="destination">
                                        Preferred Destination or Resort:
                                    </label>

                                    <input
                                        type="text"
                                        id="destination"
                                        name="destination"
                                        value="{{preferences.destination}}"
                                        placeholder="Example: Blue Lagoon">
                                </p>

                                <p>
                                    <label for="budget">
                                        Maximum Budget ($):
                                    </label>

                                    <input
                                        type="number"
                                        id="budget"
                                        name="budget"
                                        min="0.01"
                                        step="0.01"
                                        value="{{preferences.budget}}"
                                        placeholder="Example: 900">
                                </p>

                                <p>
                                    <label for="days">
                                        Trip Duration (Days):
                                    </label>

                                    <input
                                        type="number"
                                        id="days"
                                        name="days"
                                        min="1"
                                        max="365"
                                        step="1"
                                        value="{{preferences.days}}"
                                        placeholder="Example: 5">
                                </p>

                                <p>
                                    <button type="submit">
                                        Find Recommended Trips
                                    </button>

                                    <a href="/travel">
                                        Clear Preferences
                                    </a>
                                </p>

                            </form>

                            <!-- Display API messages -->
                            {{#if message}}
                                <p role="status">{{message}}</p>
                            {{/if}}

                            <!-- Recommendation results heading -->
                            {{#if hasPreferences}}
                                <h2>Recommended Trips</h2>
                                <p>
                                    Ranked by how closely each trip
                                    matches your preferences.
                                </p>
                            {{else}}
                                <h2>Available Travel Packages</h2>
                            {{/if}}

                            <!-- Display travel packages -->
                            <ul id="sites">

                                {{#each trips}}
                                <li>

                                    <a href="/api/trips/{{code}}">
                                        <img src="/images/{{image}}"
                                             alt="{{name}}">
                                    </a>

                                    <h2>
                                        <a href="/travel">{{name}}</a>
                                    </h2>

                                    <p>{{description}}</p>

                                    <p>
                                        <strong>Resort:</strong>
                                        {{resort}}
                                    </p>

                                    <p>
                                        <strong>Price Per Person:</strong>
                                        ${{perPerson}}
                                    </p>

                                    <p>
                                        <strong>Duration:</strong>
                                        {{length}}
                                    </p>

                                    {{#if ../hasPreferences}}
                                    <p>
                                        <strong>Match Score:</strong>
                                        {{recommendationScore}} / 100
                                    </p>
                                    {{/if}}

                                </li>
                                {{/each}}

                            </ul>

                        </div>
                    </div>
                </div>
            </div>

        </div>

        {{> footer }}

    </div>
</body>
</html>